+struct AttributionWindow {
+    counts: Vec<usize>,
+    positions: Vec<usize>,
+    active: Vec<u16>,
+    left: usize,
+    right: usize,
+    winner: usize,
+}
+
+impl Default for AttributionWindow {
+    fn default() -> Self {
+        Self { counts: vec![0; 65536], positions: vec![0; 65536],
+            active: Vec::new(), left: 0, right: 0, winner: 0 }
+    }
+}
+
+impl AttributionWindow {
+    fn reset(&mut self) {
+        for &campaign in &self.active { self.counts[campaign as usize] = 0; }
+        self.active.clear();
+        self.left = 0;
+        self.right = 0;
+        self.winner = 0;
+    }
+
+    fn advance(&mut self, clicks: &[LocalClick], start: i64) -> u16 {
+        while self.right < clicks.len() && clicks[self.right].ts_ms <= start {
+            let click = &clicks[self.right];
+            if self.right == 0 || clicks[self.winner].ts_ms != click.ts_ms {
+                self.winner = self.right;
+            }
+            let campaign = click.camp_idx as usize;
+            if self.counts[campaign] == 0 {
+                self.positions[campaign] = self.active.len();
+                self.active.push(click.camp_idx);
+            }
+            self.counts[campaign] += 1;
+            self.right += 1;
+        }
+        let lower = start.saturating_sub(604_800_000);
+        while self.left < self.right && clicks[self.left].ts_ms < lower {
+            let campaign = clicks[self.left].camp_idx as usize;
+            self.counts[campaign] -= 1;
+            if self.counts[campaign] == 0 {
+                let position = self.positions[campaign];
+                self.active.swap_remove(position);
+                if position < self.active.len() {
+                    self.positions[self.active[position] as usize] = position;
+                }
+            }
+            self.left += 1;
+        }
+        if self.left < self.right { clicks[self.winner].camp_idx } else { u16::MAX }
+    }
+}
