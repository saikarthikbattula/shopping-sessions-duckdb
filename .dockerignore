# Build context is limited to inputs used by the two Rust Dockerfiles.
# Keep local data, credentials, environments and scratch files out by default.
**
!native/
!native/ingest/
!native/ingest/Cargo.toml
!native/ingest/Cargo.lock
!native/ingest/rust-toolchain.toml
!native/ingest/src/
!native/ingest/src/**
!native/express-lane/
!native/express-lane/Cargo.toml
!native/express-lane/Cargo.lock
!native/express-lane/LICENSE
!native/express-lane/.cargo/
!native/express-lane/.cargo/config.toml
!native/express-lane/src/
!native/express-lane/src/**
